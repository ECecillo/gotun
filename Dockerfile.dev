# Dockerfile.dev
# Development environment with full Go toolchain for local development
#
# Purpose:
# - Local development with Docker Compose watch mode
# - Fast rebuild cycles without optimization flags
# - Full Go toolchain available for debugging (go test, go run, etc.)
# - Used by: docker compose up --watch
#
# Key differences from production:
# - No build optimization flags (faster compilation)
# - Full golang image (~259MB vs 3.65MB production)
# - Runs as root for development flexibility
# - Includes all Go tools for debugging

FROM golang:1.25.5-alpine AS development

# Install development dependencies
# git: For go get and module downloads
# ca-certificates: For HTTPS package downloads
RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Layer caching: Dependencies downloaded before source code copy
# Maximizes cache hits during development when only source changes
COPY go.mod go.sum* ./
RUN go mod download

# Copy source code
COPY . .

# Build without optimization for faster rebuilds during development
# CGO_ENABLED=0: Static binary (consistent with production)
# No -ldflags: Keep debug symbols for better debugging experience
# Docker Compose watch mode will rebuild this layer on source changes
RUN CGO_ENABLED=0 go build -o /app/tun ./cmd/tun

# Expose application port
EXPOSE 8080

# Run the application
# Note: Docker Compose watch mode auto-rebuilds container on file changes
# Future enhancement: Could use air or reflex for hot reload without rebuilds
CMD ["/app/tun"]
