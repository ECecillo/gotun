# Devtool Configuration
# =====================

# Transport protocol to use for sending packets (udp or tcp)
DEVTOOL_PROTOCOL=udp

# Destination host for packets
DEVTOOL_HOST=10.0.0.1

# Destination port for packets
DEVTOOL_PORT=8080

# Message to send
DEVTOOL_MSG=hello from devtool

# Response timeout (e.g., 2s, 500ms)
DEVTOOL_TIMEOUT=2s

