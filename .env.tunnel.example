# Tunnel Configuration
# ====================

# Source IP for the tunnel interface
TUN_SOURCE_IP=10.0.0.2

# Destination IP for the tunnel interface
TUN_DEST_IP=10.0.0.1

# Host to forward UDP packets to (leave empty to use packet destination)
TUN_FORWARD_HOST=127.0.0.1

# Port to forward UDP packets to
TUN_FORWARD_PORT=8080
