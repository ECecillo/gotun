# ===========================================
# Environment Variables Configuration
# ===========================================
# Copy the relevant sections to:
#   .env.tunnel  - for tunnel configuration
#   .env.server  - for UDP server configuration
#   .env.devtool - for devtool configuration
# ===========================================

# -------------------------------------------
# Tunnel Configuration (.env.tunnel)
# -------------------------------------------
TUN_SOURCE_IP=10.0.0.2
TUN_DEST_IP=10.0.0.1
TUN_FORWARD_HOST=127.0.0.1
TUN_FORWARD_PORT=8080

# -------------------------------------------
# UDP Server Configuration (.env.server)
# -------------------------------------------
SERVER_PORT=8080

# -------------------------------------------
# Devtool Configuration (.env.devtool)
# -------------------------------------------
DEVTOOL_HOST=10.0.0.1
DEVTOOL_PORT=8080
DEVTOOL_MSG=hello from devtool
DEVTOOL_TIMEOUT=2s
